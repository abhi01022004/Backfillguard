# BackfillGuard configuration.
#
# Every value below is optional: the committed defaults are the ones the demo runs with, and there
# are no secrets (R1.4). Copy to backend/.env only if you want to override something.

# --- server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
BODY_LIMIT=64kb

# --- database ---
DATABASE_URL="file:./data/backfillguard.db"

# --- simulation (bounds are enforced from shared/src/config.ts) ---
# Seed drives synthetic data generation and the scripted demo. Same seed => identical run.
SIM_SEED=20260905

# 100-5000
SIM_TOTAL_RECORDS=1000
# 2-20
SIM_PARTITION_COUNT=10
# records/sec, 1-500. Affects wall-clock duration only, never ordering or results.
SIM_BACKFILL_SPEED=25
# online updates per 100 processed records, 0-50
SIM_ONLINE_UPDATE_FREQ=8
# records between checkpoints, 10-500
SIM_CHECKPOINT_INTERVAL=50
# in-flight batch size, 1-100. The naive-comparison scenario depends on this; see docs.
SIM_BATCH_SIZE=25
# 1-10
SIM_MAX_REEVAL_ATTEMPTS=3

# --- risk notifications ---
# Only "demo" is implemented. It simulates messages locally and never contacts a network, so the
# project runs with no credentials and no external account. An unrecognised value falls back to
# "demo" with a warning rather than failing to start.
WHATSAPP_PROVIDER=demo

# A real provider would need credentials. They are listed here commented out on purpose: nothing in
# the code reads them, and the project must remain runnable with no secrets present at all. Never
# commit real values.
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_SENDER_ID=
